FROM docker.io/library/ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends libcurl4-openssl-dev libssl-dev libnghttp2-dev zlib1g-dev \
    libngtcp2-dev libngtcp2-crypto-ossl-dev libnghttp3-dev build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/0.11.29/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
